{
  "name": "@kidzo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KIDZO REST API: auth, child profiles, content catalog, play sessions, parent controls and admin.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsup --config tsup.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "create-admin": "tsx --env-file-if-exists=.env src/create-admin.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "content:import": "tsx --env-file-if-exists=.env scripts/content-import/run.ts",
    "content:generate": "tsx --env-file-if-exists=.env scripts/content-generate/run.ts",
    "content:report": "tsx --env-file-if-exists=.env scripts/content-tools/report.ts",
    "content:approve-dev": "tsx --env-file-if-exists=.env scripts/content-tools/approve-dev.ts",
    "content:adventures": "tsx --env-file-if-exists=.env scripts/content-adventures/run.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.8",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@kidzo/art": "workspace:*",
    "@kidzo/shared": "workspace:*",
    "@kidzo/ui-tokens": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@expo-google-fonts/fredoka": "0.4.1",
    "@expo-google-fonts/nunito": "0.4.2",
    "@resvg/resvg-js": "2.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
