# KIDZO API environment. Copy to .env and adjust. Every value has a safe dev default.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Postgres connection string. Leave unset in development to use embedded PGlite.
# Required in production, for example a Neon, Supabase or RDS URL.
# DATABASE_URL=postgres://user:password@host:5432/kidzo
PGLITE_DIR=./.data/pglite

# Required in production: 32 or more random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Browser origins allowed to call the API (admin dashboard, Expo web), comma separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Local media uploads and the public URL used to build media links.
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000

# Link sent in password reset emails. The mobile app handles kidzo://reset-password?token=...
PASSWORD_RESET_URL=kidzo://reset-password

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional: used by the seed script to create the first admin account.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
